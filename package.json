{
  "name": "x-treem",
  "version": "0.1.0",
  "description": "A focused desktop studio for simultaneous landscape and portrait streaming",
  "author": "X-treem contributors",
  "license": "GPL-3.0-only",
  "main": "electron/main.cjs",
  "scripts": {
    "prebuild": "node scripts/prepare-assets.cjs",
    "predev": "node scripts/prepare-assets.cjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "electron tests/desktop-smoke.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "peerjs": "^1.5.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.10",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "com.xtreem.studio",
    "productName": "X-treem",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "X-treem-Setup-${version}-${arch}.${ext}",
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "xunaidlnt-sudo",
      "repo": "X-treem"
    }
  }
}
